amends ".hk/org.pkl"

steps {
  ["go-mod-tidy"] {
    check = "mise exec -- go mod tidy -diff"
    fix = "mise exec -- go mod tidy"
  }
  ["go-vet"] { check = "mise exec -- go vet ./..." }
  ["go-build"] {
    glob = List("go.mod", "go.sum", "**/*.go")
    check = "mise exec -- go build ./..."
    depends = "go-vet"
    profiles = List("slow")
  }
  ["go-test"] {
    glob = List("go.mod", "go.sum", "**/*.go")
    check = "mise exec -- go test -race ./..."
    depends = "go-build"
    profiles = List("slow")
  }
}
